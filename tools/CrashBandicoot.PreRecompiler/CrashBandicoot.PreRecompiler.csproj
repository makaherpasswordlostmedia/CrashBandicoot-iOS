<Project Sdk="Microsoft.NET.Sdk">

    <!--
      CI-only tool. Runs on the GitHub Actions macOS/Linux runner BEFORE the
      iOS build starts. It performs the exact same recompilation step that
      CrashBandicoot.Launcher.Recomp.RecompRunner does on desktop/Android
      (ELF -> generated C# sources), but stops there: it does NOT invoke
      Roslyn/GameCompiler and does NOT produce a .dll.

      Why: iOS forbids loading code that wasn't known at app-build time
      (no JIT, no Assembly.Load of a fresh assembly - see
      CrashBandicoot.IosHost/README.md for the full explanation). So instead
      of compiling the generated sources into a standalone .dll at first
      launch (like Windows/Android do), we copy the generated .cs files
      straight into CrashBandicoot.IosHost/Recompiled/ as ordinary source
      files. They then get AOT-compiled together with the rest of the host
      by the normal `dotnet build -f net8.0-ios` step, like any other file
      in the project.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\RecompOne.Runtime\RecompOne.Runtime.csproj" />
        <ProjectReference Include="..\..\RecompOne.Recompiler\RecompOne.Recompiler.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\CrashBandicoot.Launcher\Recomp\DiscValidator.cs" Link="Shared\DiscValidator.cs" />
        <Compile Include="..\..\CrashBandicoot.Launcher\Recomp\PostPassApplier.cs" Link="Shared\PostPassApplier.cs" />
        <Compile Include="..\..\CrashBandicoot.Launcher\Recomp\RecompRunner.cs" Link="Shared\RecompRunner.cs" />
    </ItemGroup>

    <!--
      RecompRunner.FindPatchPath() looks for main.cs.patch next to this
      tool's built assembly (AppContext.BaseDirectory), not next to its
      source. Copy it into the output dir at build time so it's found
      at runtime without needing an explicit patch path argument.
    -->
    <ItemGroup>
        <None Include="..\..\CrashBandicoot.Launcher\Recomp\Patches\main.cs.patch"
              Link="Recomp\Patches\main.cs.patch"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
